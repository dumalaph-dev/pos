# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.open-next/
/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# production logical backups (scripts/backup-production.mjs). These hold every
# order, customer, employee and audit row in plain SQL — committing one would
# publish the store's entire ledger to the repository host. Never opt in.
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — machine-local only. Listed here rather than left to each
# developer's global ignore / .git/info/exclude so a fresh clone is clean too.
# Shared config (.claude/settings.json, agents, skills) stays committable.
.claude/launch.json
.claude/settings.local.json
.claude/worktrees/
